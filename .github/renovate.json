{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^matter_server/build\\.yaml$"],
      "matchStrings": ["TEMPIO_VERSION: (?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "muthur-command/tempio",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ssh/build\\.yaml$"],
      "matchStrings": ["CLI_VERSION: (?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "muthur-command/cli",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["muthur-command/tempio"],
      "groupName": "tempio",
      "extractVersion": "^(?:mc_)?(?<version>.*)$",
      "commitMessageTopic": "tempio",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["muthur-command/cli"],
      "groupName": "cli",
      "extractVersion": "^(?:mc_)?(?<version>.*)$",
      "commitMessageTopic": "cli",
      "commitMessageExtra": "to {{newVersion}}"
    }
  ],
  "schedule": ["every 12 hours"]
}
