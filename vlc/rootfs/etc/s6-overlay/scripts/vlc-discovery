#!/usr/bin/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Send vlc_telnet discovery information to Muthur Command
# ==============================================================================
declare ha_config

# Prepare discovery payload
ha_config=$(\
    bashio::var.json \
        host "$(hostname)" \
        port "^4212" \
        password "$(cat /data/secret)" \
)

if bashio::discovery "vlc_telnet" "${ha_config}" > /dev/null; then
    bashio::log.info "Successfully send discovery information to Muthur Command."
else
    bashio::log.error "Discovery message to Muthur Command failed!"
fi
